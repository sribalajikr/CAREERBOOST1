[TEMPLATE]
# ---- Copy this file to ".env" and adjust values ----

# Security
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# MySQL example:  mysql+pymysql://user:password@localhost:3306/career_assistant
# If the MySQL URL is unreachable the app automatically falls back to SQLite
# (career_assistant.db) so it always runs locally for free.
DATABASE_URL=sqlite:///./career_assistant.db

# CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider: "mock" uses the built-in rule-based engine (no API key needed).
# Set to "openai" and fill the key below to plug a real free-tier LLM later.
AI_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Create a demo account (demo@career.ai / demo1234) on first launch
SEED_DEMO=true

# ---- Password reset emails (REQUIRED for password reset) ----
# Reset codes are sent ONLY by email — they are never shown on screen.
# Use a Gmail App Password (Google Account > Security > 2-Step Verification >
# App passwords) or a free SMTP provider (Brevo, Mailtrap).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=CareerBoost <yourgmail@gmail.com>
